# Nothing here belongs to anyone: the athlete's tokens, cache and plan live in
# ~/.ari-coach and ~/.garminconnect, outside the repository by design. These
# rules exist so a stray copy during testing can never be committed.
garmin_tokens.json
*.db
*.db-journal
.env*
morning.log
index.html

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.DS_Store

# built artefacts
*.dxt
!fallback/*.dxt

# stray test output
tests/test.log

# delivery documents, not code — they name a specific athlete
SETUP.md
READ-ME-FIRST.txt
INSTALL.bat
INSTALL.command
